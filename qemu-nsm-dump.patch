+/*
+ * Best-effort tap for local debugging.  It is deliberately outside the NSM
+ * response path: errors and a missing peer are ignored.
+ * Frame format: big-endian u32 CBOR length followed by the raw CBOR request.
+ */
+static void nsm_dump_request(const struct iovec *request)
+{
+    static const char path[] = "/tmp/nsm-dump.sock";
+    struct sockaddr_un addr = { 0 };
+    struct timeval timeout = {
+        .tv_sec = 0,
+        .tv_usec = 100000,
+    };
+    uint32_t length;
+    const uint8_t *buf;
+    size_t remaining;
+    int fd;
+
+    if (request->iov_len > UINT32_MAX) {
+        return;
+    }
+
+    fprintf(stderr, "[NSM] len=%zu raw=", request->iov_len);
+    for (size_t i = 0; i < request->iov_len; ++i) {
+        fprintf(stderr, "%02x", ((const uint8_t *)request->iov_base)[i]);
+    }
+    fputc('\n', stderr);
+
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return;
+    }
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+
+    addr.sun_family = AF_UNIX;
+    g_strlcpy(addr.sun_path, path, sizeof(addr.sun_path));
+    if (connect(fd, (const struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        close(fd);
+        return;
+    }
+
+    length = htonl(request->iov_len);
+    buf = (const uint8_t *)&length;
+    remaining = sizeof(length);
+    while (remaining > 0) {
+        ssize_t rc = send(fd, buf, remaining, MSG_NOSIGNAL);
+        if (rc <= 0) {
+            close(fd);
+            return;
+        }
+        buf += rc;
+        remaining -= rc;
+    }
+
+    buf = request->iov_base;
+    remaining = request->iov_len;
+    while (remaining > 0) {
+        ssize_t rc = send(fd, buf, remaining, MSG_NOSIGNAL);
+        if (rc <= 0) {
+            close(fd);
+            return;
+        }
+        buf += rc;
+        remaining -= rc;
+    }
+    close(fd);
+}
